<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>VramRipperdoc</AssemblyName>
    <RootNamespace>VramRipperdoc</RootNamespace>
    <Version>0.5.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Off: a self-extracting compressed bundle looks like a packed executable to antivirus heuristics, which
         quarantined the exe for some players. The Nexus zip ends up the same size either way. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <Product>VRAM RipperDoc - Performance Optimizer</Product>
    <Company>La2o</Company>
    <Description>Ranks Cyberpunk 2077 asset mods by the VRAM and geometry they add.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app window's page (see docs/gui-api.md), served from memory: nothing is read from disk at run time. -->
    <EmbeddedResource Include="Gui\app.html" LogicalName="app.html" />
  </ItemGroup>
</Project>
